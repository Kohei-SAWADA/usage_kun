<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is referenced only for NotifyIcon (system tray); the UI is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UsageKun.App</RootNamespace>
    <AssemblyName>UsageKun</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lets the project at least compile on macOS/Linux dev machines. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <Target Name="ValidateWindowsArchitecture" BeforeTargets="PrepareForBuild;Publish">
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64' Or '$(PlatformTarget)' != 'x64'"
           Text="usage-kun supports Windows on Intel / AMD (win-x64) only." />
  </Target>

  <ItemGroup>
    <!-- The WinForms implicit global usings collide with the WPF ones
         (Application, Color, Brush). TrayIcon.cs imports them explicitly. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageKun.Core\UsageKun.Core.csproj" />
  </ItemGroup>

</Project>

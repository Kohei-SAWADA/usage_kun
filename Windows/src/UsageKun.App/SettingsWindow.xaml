<Window x:Class="UsageKun.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="usage_kun Settings"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
    <StackPanel>
        <GroupBox Header="Providers" Padding="8">
            <StackPanel>
                <CheckBox x:Name="ClaudeProviderCheck" Content="Show Claude Code"/>
                <CheckBox x:Name="CodexProviderCheck" Content="Show Codex" Margin="0,6,0,0"/>
                <CheckBox x:Name="AntigravityProviderCheck" Content="Show Gemini (Antigravity)" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Sync sources" Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="LocalLogCheck" Content="Local CLI logs (.claude / .codex)"/>
                <CheckBox x:Name="ClaudeOfficialCheck" Content="Claude usage sync (opt-in)" Margin="0,6,0,0"/>
                <TextBlock x:Name="ClaudeQuotaHelpText"
                           Text="Local Claude logs show token totals. Enable Claude usage sync to read remaining quota. Unavailable quota stays unknown."
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <CheckBox x:Name="CodexOfficialCheck" Content="Codex usage sync (opt-in)" Margin="0,6,0,0"/>
                <TextBlock Text="Uses existing Windows CLI sign-ins to read official usage. Tokens are never saved, refreshed, or logged. Sign in to the CLI first."
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <CheckBox x:Name="AntigravityUsageCheck" Content="Read Gemini quota from Antigravity (opt-in)" Margin="0,10,0,0"/>
                <TextBlock Text="Open Antigravity on Windows and sign in. Reads quota from its local service; temporary credentials are never saved or logged. Unavailable quota stays unknown."
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Behavior" Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Refresh every" VerticalAlignment="Center"/>
                    <ComboBox x:Name="RefreshIntervalCombo" Width="70" Margin="8,0"/>
                    <TextBlock Text="minutes" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="DesktopWidgetCheck" Content="Show the floating usage meter" Margin="0,10,0,0"/>
                <CheckBox x:Name="LaunchAtLoginCheck" Content="Start with Windows" Margin="0,6,0,0"/>
                <TextBlock x:Name="StartupStatusText" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ConfigPathText"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="2,10,2,0"/>
    </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1">
        <TextBlock x:Name="SaveErrorText" FontSize="12" Foreground="DarkRed"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="2,8,2,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" IsCancel="True" Click="OnCancelClick"/>
            <Button Content="Save" Width="80" Margin="8,0,0,0" IsDefault="True" Click="OnSaveClick"/>
        </StackPanel>
    </StackPanel>
    </Grid>
</Window>
